{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "id", "accountId", "label", "maskedPan", "expiry",
    "currency", "status", "availableBalance", "limits",
    "blockReason", "blockedAt", "createdAt", "spentToday"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^vcd_[a-zA-Z0-9]{8}$"
    },
    "accountId": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 30
    },
    "maskedPan": {
      "type": "string",
      "pattern": "^[0-9]{4} [0-9]{2}\\*{2} \\*{4} [0-9]{4}$"
    },
    "expiry": {
      "type": "string",
      "pattern": "^(0[1-9]|1[0-2])/[0-9]{2}$"
    },
    "currency": {
      "type": "string",
      "enum": ["AZN", "USD", "EUR"]
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "FROZEN", "BLOCKED"]
    },
    "availableBalance": {
      "type": "number",
      "minimum": 0
    },
    "limits": {
      "type": "object",
      "required": ["dailyOnline", "perTransaction"],
      "properties": {
        "dailyOnline": {
          "type": "number",
          "enum": [500]
        },
        "perTransaction": {
          "type": "number",
          "enum": [300]
        }
      }
    },
    "blockReason": {
      "type": ["string", "null"],
      "enum": [null, "TEMPORARY", "LOST", "STOLEN"]
    },
    "blockedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "spentToday": {
      "type": "number",
      "minimum": 0
    }
  }
}