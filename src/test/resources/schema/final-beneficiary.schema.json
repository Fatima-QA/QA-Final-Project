{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "id", "fullName", "iban", "ibanMasked",
    "currency", "nickname", "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ben_[a-zA-Z0-9]{8}$"
    },
    "fullName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 50
    },
    "iban": {
      "type": "string",
      "pattern": "^AZ[0-9]{2}[A-Z]{4}[A-Z0-9]{20}$"
    },
    "ibanMasked": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "enum": ["AZN", "USD", "EUR"]
    },
    "nickname": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 20
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}