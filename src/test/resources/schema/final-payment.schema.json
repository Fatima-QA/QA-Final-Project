{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "id", "receiptNo", "status", "biller", "subscriberNo",
    "amount", "fee", "total", "currency",
    "cardId", "balanceAfter", "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^bpm_[a-zA-Z0-9]{8}$"
    },
    "receiptNo": {
      "type": "string",
      "pattern": "^RCP-[0-9]{8}-[0-9]{6}$"
    },
    "status": {
      "type": "string",
      "enum": ["SUCCESS"]
    },
    "biller": {
      "type": "object",
      "required": ["id", "name", "category"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": ["UTILITY", "MOBILE", "INTERNET"]
        }
      }
    },
    "subscriberNo": {
      "type": "string",
      "minLength": 1
    },
    "amount": {
      "type": "number",
      "minimum": 0,
      "exclusiveMinimum": true
    },
    "fee": {
      "type": "number",
      "minimum": 0
    },
    "total": {
      "type": "number",
      "minimum": 0,
      "exclusiveMinimum": true
    },
    "currency": {
      "type": "string",
      "enum": ["AZN"]
    },
    "cardId": {
      "type": "string",
      "pattern": "^vcd_[a-zA-Z0-9]{8}$"
    },
    "balanceAfter": {
      "type": "number",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}